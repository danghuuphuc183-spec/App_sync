# Copy to .env.local. Get the hosted project URL and publishable key from Supabase > Connect.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# For hosted Supabase, use the `sb_publishable_...` key from Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# Legacy local development fallback only: NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-anon-key-from-supabase-start

# Required for production SMS OTP. Configure its secret in Supabase Auth CAPTCHA settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Demo login stays disabled unless explicitly enabled for local-only UI work.
NEXT_PUBLIC_DEMO_AUTOLOGIN=false
