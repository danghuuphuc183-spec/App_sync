{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sync-app-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "sync-app-dev-3010",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_DIST_DIR=.next-preview",
        "npx",
        "next",
        "dev",
        "--port",
        "3010"
      ],
      "port": 3010
    },
    {
      "name": "sync-app-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "--port",
        "3020"
      ],
      "port": 3020
    },
    {
      "name": "sync-app-prodcheck",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_DIST_DIR=.next-prodcheck",
        "npx",
        "next",
        "start",
        "--port",
        "3030"
      ],
      "port": 3030
    }
